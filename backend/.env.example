# AgentShield Environment Configuration
PROJECT_NAME=AgentShield
ENV=development
PORT=8000
HOST=0.0.0.0

# Security & Circuit Breaker Thresholds
MAX_VELOCITY_USD_PER_MINUTE=100.00
MAX_TRANSACTION_LIMIT_USD=50.00
MAX_DRIFT_THRESHOLD=0.25
AUTOMATIC_KILL_SWITCH_ENABLED=true

# PayPal Developer Sandbox Credentials
# Register at: https://developer.paypal.com/
PAYPAL_CLIENT_ID=sandbox_client_id_placeholder
PAYPAL_CLIENT_SECRET=sandbox_client_secret_placeholder
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=sandbox_webhook_id_placeholder
